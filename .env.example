# Copy to .env and fill in. Never commit .env.

# Shared secret the web app sends as "Authorization: Bearer <token>". At least 32 characters.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# mock = in-memory fake PowerFab for development; remote = the real PowerFab Remote Server.
POWERFAB_MODE=mock

# PowerFab Remote Server (Remote Monitor > Socket). 9154 is Tekla's default port.
# From a container on the PowerFab server itself, host.docker.internal usually reaches the host.
POWERFAB_HOST=
POWERFAB_PORT=9154
# External user created in PowerFab with permission to log in and view jobs.
POWERFAB_USERNAME=
POWERFAB_PASSWORD=

# Leave false until reads are verified against your real data. true lets the API load, unload and ship.
POWERFAB_ALLOW_WRITES=false

# Comma-separated origins allowed to call the API from a browser, e.g. https://atagtheawesomest.github.io
CORS_ORIGINS=

# Only for docker compose --profile tunnel (Tailscale Funnel).
# Auth key from https://login.tailscale.com/admin/settings/keys (reusable, tag it e.g. tag:powerfab).
TS_AUTHKEY=
TS_HOSTNAME=powerfab-bridge
