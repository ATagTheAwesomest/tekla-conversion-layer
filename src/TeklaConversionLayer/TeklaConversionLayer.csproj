<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- How files (photos) are stored: served at GET /api/files/help and copied next to the exe. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\FILES.md" LogicalName="TeklaConversionLayer.FILES.md" />
    <None Include="..\..\docs\FILES.md" Link="FILES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\windows\file-rules.example.json" Link="file-rules.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Tekla.PowerFab.API" Version="1.0.1" />
  </ItemGroup>

</Project>
